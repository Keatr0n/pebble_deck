        }
      },
      {
        "type": "input",
        "messageKey": "CustomApiRegex",
        "label": "Extract Regex",
        "defaultValue": "\"summary\"\\s*:\\s*\"?([^\"]+)\"?",
        "attributes": {
          "placeholder": "\"summary\"\\s*:\\s*\"?([^\"]+)\"?",
          "type": "text"
        },
        "description": "First capture group is sent to the watch (max 12 chars)."
      },
